# Server
HOST=127.0.0.1
PORT=8000
DEBUG=true
DEVICE=cuda

# Faster-Whisper (RTX 3060: medium.en float16 ~2–3 GB)
WHISPER_MODEL_SIZE=medium.en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=1

# Ollama (pull one of these first)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_FALLBACK_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_PREDICT=220
OLLAMA_NUM_CTX=2048
# Integer -1 = keep model forever in VRAM. Do NOT quote as "-1" (Ollama 400).
OLLAMA_KEEP_ALIVE=-1

# TTS: kokoro | piper
TTS_ENGINE=kokoro
KOKORO_VOICE=af_sarah
KOKORO_SPEED=1.0

# Force ONNX CUDA EP when onnxruntime-gpu is installed
ONNX_PROVIDER=CUDAExecutionProvider

TARGET_PIPELINE_LATENCY_S=2.0
